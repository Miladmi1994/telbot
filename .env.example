# Copy to .env and fill in real values (never commit .env)

BOT_TOKEN=your_telegram_bot_token
GROUP_ID=-100xxxxxxxxxx
TOPIC_SUPPORT=8
TOPIC_ERROR=6
TOPIC_PAYMENT=2
TOPIC_TEST=4
ADMIN_ID=123456789

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=Cluster0
MONGODB_DB=telbot

# Fallback panel credentials (used only when a server record is missing fields)
DEFAULT_PANEL_URL=http://your-panel-host:port
DEFAULT_PANEL_WEB_BASE_PATH=/your-path
DEFAULT_PANEL_API_TOKEN=your_panel_api_token
DEFAULT_PANEL_INBOUND_ID=1
